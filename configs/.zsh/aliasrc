# ls
if (( $+commands[eza] )); then
    alias ls="eza --group-directories-first --icons=auto"
    alias l="ll"
    alias ll="ls -l --git"
    alias la="ls -a"
    alias lla="ls -la --git"
    alias lt="ls --tree --level=2"
else
    alias ls="ls --color=auto --group-directories-first"
    alias l="ll"
    alias ll="ls -l"
    alias la="ls -A"
    alias lla="ls -lA"
fi

# mkdir
alias mkdir="mkdir -pv"

# cd
function .. {
    local count=${1:-1}
    (( count < 1 )) && count=1

    for i in {1..$count}
    do
        cd ..
    done
}

alias ra="ranger"

# confirmations
alias mv='mv -i'
alias cp='cp -i'
alias rm='rm -i'
alias ln='ln -i'

# vim
alias vim="nvim"
alias v="vim"
alias vi="vim"
alias sv="sudoedit"

# python
alias pe="pipenv"
